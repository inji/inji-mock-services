{
  "info": {
    "name": "Inji Student Usecase API",
    "description": "REST API collection for Student Management Backend (inji-usecase service)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "graduation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "created_student_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Students",
      "item": [
        {
          "name": "Create Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.studentId) {",
                  "        pm.collectionVariables.set('created_student_id', jsonData.studentId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU-2025-006\",\n  \"fullName\": \"Sneha Gupta\",\n  \"email\": \"sneha.gupta@university.edu\",\n  \"phoneNumber\": \"+91-9876543260\",\n  \"dateOfBirth\": \"2003-04-12\",\n  \"address\": \"42 Connaught Place, New Delhi 110001\",\n  \"courseProgram\": \"B.Tech Information Technology\",\n  \"enrollmentDate\": \"2025-08-01\",\n  \"academicYear\": \"2025-2029\",\n  \"cgpa\": 0.00,\n  \"guardianName\": \"Ramesh Gupta\",\n  \"guardianPhone\": \"+91-9876543261\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/students",
              "host": ["{{base_url}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/students",
              "host": ["{{base_url}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/students/STU-2022-001",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "STU-2022-001"]
            }
          }
        },
        {
          "name": "Update Student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU-2022-001\",\n  \"fullName\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@university.edu\",\n  \"phoneNumber\": \"+91-9876543210\",\n  \"dateOfBirth\": \"2001-03-15\",\n  \"address\": \"123 MG Road, Bangalore, Karnataka 560001\",\n  \"courseProgram\": \"B.Tech Computer Science\",\n  \"enrollmentDate\": \"2022-08-01\",\n  \"academicYear\": \"2022-2026\",\n  \"cgpa\": 9.00,\n  \"guardianName\": \"Rajesh Sharma\",\n  \"guardianPhone\": \"+91-9876543211\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/students/STU-2022-001",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "STU-2022-001"]
            }
          }
        },
        {
          "name": "Delete Student",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/students/{{created_student_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "{{created_student_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Graduation Details",
      "item": [
        {
          "name": "Add Graduation Details",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var regNum = 'REG-' + Date.now();",
                  "pm.collectionVariables.set('dynamic_reg_number', regNum);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.id) {",
                  "        pm.collectionVariables.set('graduation_id', jsonData.id);",
                  "        console.log('Saved graduation_id:', jsonData.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"{{dynamic_reg_number}}\",\n  \"degreeTitle\": \"Bachelor of Science in Data Science\",\n  \"graduationMonth\": 6,\n  \"graduationYear\": 2026,\n  \"classification\": \"First Class\",\n  \"certificateStatus\": \"PENDING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/students/STU-2023-004/graduation",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "STU-2023-004", "graduation"]
            }
          }
        },
        {
          "name": "Get Graduation Details for Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (Array.isArray(jsonData) && jsonData.length > 0 && jsonData[0].id) {",
                  "    pm.collectionVariables.set('graduation_id', jsonData[0].id);",
                  "    console.log('Saved graduation_id:', jsonData[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/students/STU-2022-001/graduation",
              "host": ["{{base_url}}"],
              "path": ["api", "students", "STU-2022-001", "graduation"]
            }
          }
        },
        {
          "name": "Update Graduation Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"REG-2026-BTech-002\",\n  \"degreeTitle\": \"Bachelor of Technology in Computer Science\",\n  \"graduationMonth\": 6,\n  \"graduationYear\": 2026,\n  \"classification\": \"First Class with Distinction\",\n  \"certificateStatus\": \"ISSUED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/graduation/{{graduation_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "graduation", "{{graduation_id}}"]
            }
          }
        },
        {
          "name": "Delete Graduation Detail",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/graduation/{{graduation_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "graduation", "{{graduation_id}}"]
            }
          }
        },
        {
          "name": "Search Graduation by Year",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/graduation/search?year=2026",
              "host": ["{{base_url}}"],
              "path": ["api", "graduation", "search"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                }
              ]
            }
          }
        },
        {
          "name": "Search Graduation by Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/graduation/search?status=ISSUED",
              "host": ["{{base_url}}"],
              "path": ["api", "graduation", "search"],
              "query": [
                {
                  "key": "status",
                  "value": "ISSUED"
                }
              ]
            }
          }
        },
        {
          "name": "Search Graduation by Registration Number",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/graduation/search?registrationNumber=REG-2023-MTech-001",
              "host": ["{{base_url}}"],
              "path": ["api", "graduation", "search"],
              "query": [
                {
                  "key": "registrationNumber",
                  "value": "REG-2023-MTech-001"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
